# ===== Bot Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Jadwal report (waktu lokal REPORT_TIMEZONE) =====
MORNING_CRON=15 8 * * 1-5
EVENING_CRON=15 16 * * 1-5
REPORT_TIMEZONE=Asia/Jakarta

# Daemon mengirim pagi+sore sendiri (menggantikan Task Scheduler Windows).
# Jika memilih crontab/systemd-timer + --once sebagai pengganti, set ke 0 agar tidak dobel kirim.
MORNING_ENABLED=1
EVENING_ENABLED=1

# ===== Server data Stockbit (Linux) =====
# Butuh Node.js >= 22 (stockbit-mcp@1.3.0 mewajibkannya).
STOCKBIT_SERVER_NODE=node
# Debian/Ubuntu (node via apt/nodesource):
STOCKBIT_SERVER_SCRIPT=/usr/lib/node_modules/stockbit-mcp/dist/bin/stockbit-mcp.js
# Image resmi node / tarball nodejs.org: /usr/local/lib/node_modules/stockbit-mcp/dist/bin/stockbit-mcp.js
STOCKBIT_TOOLS=core

# Lokasi sesi/token Stockbit. Biarkan kosong bila memakai default (~/.stockbit).
# STOCKBIT_STORE_DIR=/var/lib/stockbitbot/.stockbit